# ==============================================================================
# ProofGrid Environment Configuration Template
# DO NOT ADD REAL SECRETS TO THIS FILE OR TO VERSION CONTROL.
# Copy this file to .env and provide local or deployment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP (Phase 1 Baseline - Required for process boot)
# ------------------------------------------------------------------------------
APP_ENV=local
APP_NAME=proofgrid-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------------------
# DATABASE (Phase 2 - Neon PostgreSQL Authoritative Persistence)
# ------------------------------------------------------------------------------
# Pooled runtime connection (PgBouncer in transaction mode for FastAPI & Worker)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection (for Alembic DDL migrations and administrative operations)
DATABASE_DIRECT_URL=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED= # Supported alias for DATABASE_DIRECT_URL

RAW_EVIDENCE_BUCKET=proofgrid-raw-evidence

# ------------------------------------------------------------------------------
# LLM (Phase 3+ - Planning and Structured Extraction)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-placeholder
PLANNER_MODEL=gpt-4o-2024-08-06
EXTRACTOR_MODEL=gpt-4o-mini-2024-07-18

# ------------------------------------------------------------------------------
# SEARCH (Phase 6+ - Public Source Discovery)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key-placeholder

# ------------------------------------------------------------------------------
# QDRANT (Phase 14 - Auxiliary Vector Index)
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-qdrant-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-placeholder
QDRANT_COLLECTION=proofgrid_entities
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# OBSERVABILITY (Optional telemetry and error tracking)
# ------------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# FEATURE FLAGS & LIMITS
# ------------------------------------------------------------------------------
AUTH_ENABLED=false
ENABLE_BROWSER=false
ENABLE_QDRANT=false
ENABLE_PATHWAY=false
ENABLE_N8N_WEBHOOKS=false
STRICT_EVIDENCE=true
ACQUISITION_MODE=LIVE
MAX_CONCURRENT_RUNS=3
MAX_HTTP_CONCURRENCY=8
MAX_DOMAIN_CONCURRENCY=2
